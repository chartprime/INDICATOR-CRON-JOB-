# Template for /etc/terminal-l1-l2/query/service.env
# Real file: root-owned, chmod 0600, outside the checkout. Loaded by systemd
# EnvironmentFile= before the ttquery user is entered. Placeholders only.
#
# Read-only S3 identity for the archive query service. Grant only `s3:GetObject`
# on the curated archive namespace. It must not read raw data or write, delete,
# list, or publish curated objects.
TT_QUERY_S3_REGION=eu-central-1
TT_QUERY_S3_ACCESS_KEY_ID=
TT_QUERY_S3_SECRET_ACCESS_KEY=
#
# Shared secret the serving gateway presents to this loopback service. It
# authenticates the gateway, never an end user; browser credentials are resolved
# in the gateway and only the derived client identity is forwarded. The same
# value belongs in the serving gateway's protected environment. The gateway is
# supervised and loopback-only; do not distribute this secret to browser
# clients or expose either service for user traffic before its deployment gate
# has passed.
TT_QUERY_SERVICE_SECRET=
