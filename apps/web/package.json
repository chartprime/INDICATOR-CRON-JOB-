{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "pretest": "node ../../scripts/verify-node-version.cjs",
    "prebuild": "node ../../scripts/verify-node-version.cjs",
    "dev": "node ../../scripts/node-launcher.cjs ../../node_modules/vite/bin/vite.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "node ../../scripts/node-launcher.cjs ../../node_modules/vite/bin/vite.js preview",
    "test": "set \"ELECTRON_RUN_AS_NODE=\"&& vitest run"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "trading-signals": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "fast-check": "4.10.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@oxlint/binding-linux-x64-gnu": "1.73.0"
  }
}
