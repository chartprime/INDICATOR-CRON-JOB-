# Template for /etc/terminal-l1-l2/live-storage/service.env
# Real file: root-owned, chmod 0600, outside the checkout. Loaded by systemd
# EnvironmentFile= before the ttcollect user is entered. Placeholders only.
#
# Shared secret the serving gateway presents to this loopback service. It
# authenticates the gateway, never an end user; developer credentials are
# resolved in the gateway and only the derived client identity is forwarded
# (x-live-storage-client). The same value belongs in the gateway's
# TT_LIVE_STORAGE_SERVICE_SECRET, separate from TT_QUERY_SERVICE_SECRET. This
# service is loopback-only; do not distribute this secret to a browser build
# or a developer's laptop.
TT_LIVE_STORAGE_SERVICE_SECRET=
