[Unit]
Description=Terminal-L1-L2 capture retention (Binance and dxFeed live databases, 21 days)
RequiresMountsFor=/srv/terminal-data
OnFailure=terminal-alert@%n.service

[Service]
Type=oneshot
User=ttcollect
Group=ttcollect
Slice=terminal.slice
WorkingDirectory=/opt/terminal-l1-l2/current/apps/runtime
Environment=TT_DATA_ROOT=/srv/terminal-data/capture
Environment=TT_LOG_DIR=/var/log/terminal-l1-l2/collect
LogsDirectory=terminal-l1-l2/collect
ExecStartPre=/usr/bin/mountpoint -q /srv/terminal-data
ExecStart=/opt/terminal-l1-l2/node-v24.21.0-linux-x64/bin/node /opt/terminal-l1-l2/current/apps/runtime/scripts/maintain/prune-capture-retention.js --target all --days 21 --max-seconds 5400 --export-watermark /var/lib/terminal-l1-l2/capture-export/watermark.json
TimeoutStartSec=6000
Nice=10
IOWeight=50
MemoryMax=512M
TasksMax=32
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/srv/terminal-data/capture
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-capture-retention
