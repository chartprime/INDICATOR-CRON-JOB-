{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal-l1-l2/contracts/archive-query/v1",
  "title": "Archive Query Contract v1",
  "description": "Every historical read request and response crossing the boundary between the Node data service and the isolated Python reader workers. The two sides cannot share a module -- one is Node, one is Python -- so the bounds in this file are the authority and a reconciliation test asserts both implementations agree with it, exactly as ws-frame-contract-v1 does across the runtime/web workspace boundary. Instruments are deliberately NOT an enum: the published catalog decides which instruments exist, so an enum here would need editing whenever one is published. Families ARE an enum because they are a closed subset of the market-observation contract's FAMILIES and every one needs a reader implementation.",
  "$defs": {
    "admissionLimits": {
      "type": "object",
      "description": "Mirrors server/aggressive-history.js, which already bounds the terminal's other paged history path. Concurrency is capped globally and at one in-flight read per client, so a single caller cannot monopolise the readers. Readers are separate processes because W6.03 measured eight in-process readers at p95 5.58 s against 101.5 ms across processes.",
      "properties": {
        "maxConcurrentReads": {
          "const": 2
        },
        "maxQueued": {
          "const": 32
        },
        "maxQueueWaitMs": {
          "const": 15000
        },
        "rateLimitMax": {
          "const": 72
        },
        "rateLimitWindowMs": {
          "const": 60000
        }
      },
      "additionalProperties": false
    },
    "httpLimits": {
      "type": "object",
      "description": "Loopback HTTP request-body bounds. The body limit is deliberately above the largest schema-valid request, while keeping one request unable to consume unbounded server memory. The timeout bounds an incomplete Content-Length body before it can occupy an HTTP thread indefinitely. The inbound handler bound is separate from archive admission: admission limits reader work, while the HTTP server reserves an inbound slot before creating a handler thread and otherwise returns an immediate overload refusal.",
      "properties": {
        "maxRequestBytes": {
          "const": 65536
        },
        "requestBodyTimeoutSeconds": {
          "const": 5
        },
        "maxInboundHandlers": {
          "const": 16
        }
      },
      "additionalProperties": false
    },
    "archiveRow": {
      "oneOf": [
        {
          "$ref": "#/$defs/tradeRow"
        },
        {
          "$ref": "#/$defs/quoteRow"
        },
        {
          "$ref": "#/$defs/candleRow"
        },
        {
          "$ref": "#/$defs/depthRow"
        },
        {
          "$ref": "#/$defs/trade_minuteRow"
        },
        {
          "$ref": "#/$defs/trade_levelRow"
        },
        {
          "$ref": "#/$defs/trade_sliceRow"
        },
        {
          "$ref": "#/$defs/trade_printsRow"
        }
      ],
      "description": "A complete, flat persisted Parquet row. The response family selects the matching row variant. Exact decimal and 64-bit values are strings so the Python-to-Node boundary cannot silently round them."
    },
    "derivedRowBase": {
      "type": "object",
      "description": "The envelope a derived aggregate carries on the wire. A trade_* row is a bucket, not an observation: the request names the instrument and the catalog vouches for the lineage, so serving the full identity envelope would cost about four times the payload for nothing a consumer can use.",
      "required": [
        "event_ns"
      ],
      "properties": {
        "event_ns": {
          "$ref": "#/$defs/unsigned64"
        }
      }
    },
    "archiveRowBase": {
      "type": "object",
      "required": [
        "record_id",
        "event_ns",
        "source_rank",
        "stable_position",
        "ordinal",
        "sequence",
        "receive_ns",
        "ingest_ns",
        "time_precision",
        "time_origin",
        "instrument_id",
        "venue",
        "market",
        "symbol",
        "currency",
        "size_unit",
        "contract",
        "source_provider",
        "source_dataset",
        "source_schema",
        "source_population",
        "source_dataset_version",
        "source_method_version",
        "source_symbol",
        "mapping_version",
        "mapping_reference",
        "stream_id",
        "lineage_sha256",
        "lineage_row",
        "quality_state",
        "quality_flags"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "event_ns": {
          "$ref": "#/$defs/eventNs"
        },
        "source_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "stable_position": {
          "$ref": "#/$defs/unsigned64"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "sequence": {
          "$ref": "#/$defs/nullableInteger64"
        },
        "receive_ns": {
          "$ref": "#/$defs/nullableUnsigned64"
        },
        "ingest_ns": {
          "$ref": "#/$defs/nullableUnsigned64"
        },
        "time_precision": {
          "$ref": "#/$defs/nullableText"
        },
        "time_origin": {
          "$ref": "#/$defs/nullableText"
        },
        "instrument_id": {
          "$ref": "#/$defs/instrumentId"
        },
        "venue": {
          "$ref": "#/$defs/nullableText"
        },
        "market": {
          "$ref": "#/$defs/nullableText"
        },
        "symbol": {
          "$ref": "#/$defs/nullableText"
        },
        "currency": {
          "$ref": "#/$defs/nullableText"
        },
        "size_unit": {
          "$ref": "#/$defs/nullableText"
        },
        "contract": {
          "$ref": "#/$defs/nullableText"
        },
        "source_provider": {
          "$ref": "#/$defs/nullableText"
        },
        "source_dataset": {
          "$ref": "#/$defs/nullableText"
        },
        "source_schema": {
          "$ref": "#/$defs/nullableText"
        },
        "source_population": {
          "$ref": "#/$defs/nullableText"
        },
        "source_dataset_version": {
          "$ref": "#/$defs/nullableText"
        },
        "source_method_version": {
          "$ref": "#/$defs/nullableText"
        },
        "source_symbol": {
          "$ref": "#/$defs/nullableText"
        },
        "mapping_version": {
          "$ref": "#/$defs/nullableText"
        },
        "mapping_reference": {
          "$ref": "#/$defs/nullableText"
        },
        "stream_id": {
          "$ref": "#/$defs/nullableText"
        },
        "lineage_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lineage_row": {
          "$ref": "#/$defs/nullableUnsigned64"
        },
        "quality_state": {
          "$ref": "#/$defs/nullableText"
        },
        "quality_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "byteCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "A non-negative byte count kept within JavaScript's exact integer range. The estimate may exceed the synchronous request cap."
    },
    "bytesPerRow": {
      "type": "object",
      "description": "Measured bytes per row per family, used for the pre-fetch scan estimate because the catalog records record_count and part_count but no byte size. Calibrated against 12 published manifests per family: quote holds within 3% of its median, candle 8%, trade 21%. Each value is that family's measured maximum so the estimate errs high. Validated end to end against a real partition at 1.023x actual. Depth is a placeholder: no depth partition has ever been published, so an uncalibrated non-empty depth window is refused with ESTIMATE_UNVERIFIED rather than admitted on a guess. candle_1m and candle_1h carry candle's rate because they share its exact column set, not because either has been measured; both are due re-calibration against their own published manifests, and the shared row shape makes that an adjustment rather than a guess. The four trade_* aggregates are measured from their own published manifests (the six largest partitions of each, on the production archive), rounded up: they are estimates of what a partition holds on disk, while the wire carries only the declared payload, so the estimate errs high for them by design.",
      "properties": {
        "candle": {
          "const": 59
        },
        "candle_1m": {
          "const": 59
        },
        "candle_1h": {
          "const": 59
        },
        "candle_1d": {
          "const": 59
        },
        "trade": {
          "const": 60
        },
        "quote": {
          "const": 49
        },
        "depth": {
          "const": 600
        },
        "trade_minute_1m": {
          "const": 99
        },
        "trade_level_1m": {
          "const": 47
        },
        "trade_slice_2s": {
          "const": 70
        },
        "trade_prints_1m": {
          "const": 60
        }
      },
      "additionalProperties": false
    },
    "bytesPerRowUnverified": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/family"
      },
      "const": [
        "depth"
      ],
      "description": "Families whose bytes-per-row is not calibrated against a published partition."
    },
    "cacheLimits": {
      "type": "object",
      "description": "Serving-cache and snapshot-registry bounds. Provisional pending D09, which owns retention policy. The cache cap comfortably holds the catalogued archive (20.42 GB measured) and near-term L1 growth; the free-disk reserve protects conversion staging and the live collector, which share the volume. Snapshot bounds are part of the serving contract because they determine how long a pointer token remains usable and how many independent page chains the service can retain. Declared here because they are operator decisions, not implementation details -- an earlier revision of this schema carried bounds that a rewrite dropped, leaving numbers recorded nowhere but Python.",
      "properties": {
        "maxCacheBytes": {
          "const": 274877906944
        },
        "minFreeDiskBytes": {
          "const": 214748364800
        },
        "fetchConcurrency": {
          "const": 8
        },
        "snapshotTtlSeconds": {
          "const": 900
        },
        "maxSnapshotEntries": {
          "const": 256
        },
        "maxSnapshotEntriesPerClient": {
          "const": 16
        }
      },
      "additionalProperties": false
    },
    "candleRow": {
      "allOf": [
        {
          "$ref": "#/$defs/archiveRowBase"
        },
        {
          "type": "object",
          "required": [
            "open_ns",
            "close_ns",
            "open",
            "high",
            "low",
            "close",
            "volume",
            "buy_volume",
            "closed",
            "method",
            "quote_volume",
            "taker_buy_quote_volume",
            "taker_sell_base_volume",
            "taker_sell_quote_volume",
            "trade_count"
          ],
          "properties": {
            "open_ns": {
              "$ref": "#/$defs/nullableUnsigned64"
            },
            "close_ns": {
              "$ref": "#/$defs/nullableUnsigned64"
            },
            "open": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "high": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "low": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "close": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "volume": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "buy_volume": {
              "$ref": "#/$defs/nullableExactDecimal"
            },
            "closed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "method": {
              "$ref": "#/$defs/nullableText"
            },
            "quote_volume": {
              "$ref": "#/$defs/nullableExactDecimal",
              "description": "Turnover in the quote currency. Source-supplied, not derived from volume and price, because a bar's trades happen at many prices. Null wherever the source does not report it."
            },
            "taker_buy_quote_volume": {
              "$ref": "#/$defs/nullableExactDecimal",
              "description": "Quote-currency turnover taken by aggressive buyers. Null wherever the source does not report it."
            },
            "taker_sell_base_volume": {
              "$ref": "#/$defs/nullableExactDecimal",
              "description": "volume minus buy_volume by exact decimal subtraction. A source reporting taker-buy above total volume is rejected at conversion rather than clamped, so this is never negative."
            },
            "taker_sell_quote_volume": {
              "$ref": "#/$defs/nullableExactDecimal",
              "description": "quote_volume minus taker_buy_quote_volume by exact decimal subtraction, under the same rejection rule."
            },
            "trade_count": {
              "$ref": "#/$defs/nullableInteger64",
              "description": "Trades that composed the bar. Null is the honest value for a source that does not report it -- zero would assert an empty bar. Databento OHLCV carries no trade count, so every Databento candle reports null here."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "coverage": {
      "type": "object",
      "required": [
        "requested",
        "served",
        "partitions",
        "states"
      ],
      "properties": {
        "requested": {
          "$ref": "#/$defs/window"
        },
        "served": {
          "oneOf": [
            {
              "$ref": "#/$defs/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "partitions": {
          "type": "integer",
          "minimum": 0
        },
        "states": {
          "type": "object",
          "description": "Counts per W6.07 coverage state. The vocabulary is closed and inherited, not redefined here.",
          "propertyNames": {
            "enum": [
              "PUBLISHED",
              "QUIET",
              "MARKET_CLOSED",
              "MISSING",
              "QUARANTINED",
              "FAILED",
              "CORRUPT",
              "UNKNOWN"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "date",
              "state"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "state": {
                "enum": [
                  "MISSING",
                  "QUARANTINED",
                  "FAILED",
                  "CORRUPT",
                  "UNKNOWN"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "corrupt": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object",
            "required": [
              "date"
            ],
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 128
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Opaque base64url of the canonical sort key plus the pointer identity it was issued against. Keyset, never offset: offset pagination cannot be stable across tied timestamps."
    },
    "cursorPayload": {
      "type": "object",
      "required": [
        "version",
        "expiresAt",
        "queryFingerprint",
        "pointerSha256",
        "eventNs",
        "sourceRank",
        "stablePosition",
        "ordinal",
        "tag"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        },
        "pointerSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "eventNs": {
          "$ref": "#/$defs/eventNs"
        },
        "sourceRank": {
          "type": "integer",
          "minimum": 0
        },
        "stablePosition": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "queryFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 over contractVersion, pointer identity, instrumentId, family, from, to and the sort-key semantics. A cursor is valid only for the query that issued it."
        },
        "tag": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "depthLevel": {
      "type": "object",
      "required": [
        "price",
        "size"
      ],
      "properties": {
        "price": {
          "$ref": "#/$defs/exactDecimal"
        },
        "size": {
          "$ref": "#/$defs/exactDecimal"
        }
      },
      "additionalProperties": false
    },
    "depthRow": {
      "allOf": [
        {
          "$ref": "#/$defs/archiveRowBase"
        },
        {
          "type": "object",
          "required": [
            "depth_action",
            "depth_model",
            "depth_limit",
            "bids",
            "asks",
            "first_sequence",
            "last_sequence",
            "previous_sequence",
            "batch_id",
            "batch_end",
            "reset",
            "book_epoch",
            "continuity",
            "dbn_source_flags",
            "dbn_publisher_id"
          ],
          "properties": {
            "depth_action": {
              "$ref": "#/$defs/nullableText"
            },
            "depth_model": {
              "$ref": "#/$defs/nullableText"
            },
            "depth_limit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "bids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/depthLevel"
              }
            },
            "asks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/depthLevel"
              }
            },
            "first_sequence": {
              "$ref": "#/$defs/nullableInteger64"
            },
            "last_sequence": {
              "$ref": "#/$defs/nullableInteger64"
            },
            "previous_sequence": {
              "$ref": "#/$defs/nullableInteger64"
            },
            "batch_id": {
              "$ref": "#/$defs/nullableText"
            },
            "batch_end": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "reset": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "book_epoch": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                {
                  "type": "null"
                }
              ]
            },
            "continuity": {
              "$ref": "#/$defs/nullableText"
            },
            "dbn_source_flags": {
              "type": [
                "integer",
                "null"
              ]
            },
            "dbn_publisher_id": {
              "$ref": "#/$defs/nullableInteger64"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "error": {
      "type": "object",
      "required": [
        "contractVersion",
        "error"
      ],
      "properties": {
        "contractVersion": {
          "const": "archive-query/1"
        },
        "error": {
          "$ref": "#/$defs/errorCode"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "detail": {
          "type": "string",
          "maxLength": 512
        },
        "requestedWindowNs": {
          "$ref": "#/$defs/unsigned64"
        },
        "maxWindowNs": {
          "$ref": "#/$defs/unsigned64"
        },
        "estimatedScanBytes": {
          "$ref": "#/$defs/byteCount"
        },
        "effectiveMaxScanBytes": {
          "$ref": "#/$defs/scanBytes"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 1,
          "description": "Present on OVERLOADED. How long before the caller's rate budget or a reader slot is expected to free, so a client backs off by instruction rather than by guess."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "const": "RANGE_TOO_LARGE"
              }
            }
          },
          "then": {
            "required": [
              "estimatedScanBytes",
              "effectiveMaxScanBytes"
            ]
          }
        },
        {
          "if": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "const": "WINDOW_TOO_LARGE"
              }
            }
          },
          "then": {
            "required": [
              "family",
              "requestedWindowNs",
              "maxWindowNs"
            ]
          }
        },
        {
          "if": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "const": "ESTIMATE_UNVERIFIED"
              }
            }
          },
          "then": {
            "required": [
              "family"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "errorCode": {
      "enum": [
        "CACHE_CAPACITY_EXCEEDED",
        "CANCELLED",
        "CATALOG_INTEGRITY_FAILURE",
        "CURSOR_MALFORMED",
        "CURSOR_POINTER_MISMATCH",
        "ESTIMATE_UNVERIFIED",
        "INVALID_WINDOW",
        "MALFORMED_REQUEST",
        "OVERLOADED",
        "PARTITION_VERIFICATION_FAILED",
        "POINTER_TOKEN_INVALID",
        "RANGE_TOO_LARGE",
        "READER_UNAVAILABLE",
        "UNAUTHORIZED",
        "UNKNOWN_INSTRUMENT",
        "UNSUPPORTED_FAMILY",
        "WINDOW_TOO_LARGE"
      ]
    },
    "httpStatusByError": {
      "type": "object",
      "description": "HTTP status for every declared error envelope emitted by the loopback archive service. This mapping is contract metadata and is reconciled against the service rather than allowing an unmapped error to fall through as an accidental 500.",
      "properties": {
        "CACHE_CAPACITY_EXCEEDED": {"const": 503},
        "CANCELLED": {"const": 499},
        "CATALOG_INTEGRITY_FAILURE": {"const": 500},
        "CURSOR_MALFORMED": {"const": 400},
        "CURSOR_POINTER_MISMATCH": {"const": 400},
        "ESTIMATE_UNVERIFIED": {"const": 503},
        "INVALID_WINDOW": {"const": 400},
        "MALFORMED_REQUEST": {"const": 400},
        "OVERLOADED": {"const": 429},
        "PARTITION_VERIFICATION_FAILED": {"const": 500},
        "POINTER_TOKEN_INVALID": {"const": 409},
        "RANGE_TOO_LARGE": {"const": 413},
        "READER_UNAVAILABLE": {"const": 503},
        "UNAUTHORIZED": {"const": 401},
        "UNKNOWN_INSTRUMENT": {"const": 404},
        "UNSUPPORTED_FAMILY": {"const": 400},
        "WINDOW_TOO_LARGE": {"const": 413}
      },
      "additionalProperties": false
    },
    "eventNs": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "maxLength": 20,
      "description": "Epoch nanoseconds as a decimal string. Never a JSON number: 2^53 is exceeded by nanosecond timestamps and a float would silently lose precision."
    },
    "exactDecimal": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,25})(?:\\.[0-9]{1,12})?$",
      "maxLength": 40,
      "description": "Exact DuckDB DECIMAL(38,12) text. It is never a JSON number because a binary float may round either price or size."
    },
    "family": {
      "description": "Row family. Candle families name their bar resolution; 'candle' is the original one-second family and keeps that name so published partitions need no migration. The trade_* families are aggregates derived from trade, and carry only their payload on the wire.",
      "enum": [
        "candle",
        "candle_1m",
        "candle_1h",
        "candle_1d",
        "trade",
        "quote",
        "depth",
        "trade_minute_1m",
        "trade_level_1m",
        "trade_slice_2s",
        "trade_prints_1m"
      ]
    },
    "instrumentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "integer64": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,18})$",
      "maxLength": 20,
