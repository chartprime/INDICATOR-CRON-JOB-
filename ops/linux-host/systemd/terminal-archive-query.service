# Archive query service (W6.10). Exactly one process: snapshot tokens and cursor
# signatures are process-local, so a second instance issues unresolvable ones.
[Unit]
Description=Terminal-L1-L2 archive query service
Wants=network-online.target
After=network-online.target time-sync.target
RequiresMountsFor=/srv/terminal-data
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=terminal-alert@%n.service

[Service]
Type=simple
User=ttquery
Group=ttquery
Slice=terminal.slice
WorkingDirectory=/opt/terminal-l1-l2/current/apps/runtime
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/terminal-l1-l2/query/service.env
LogsDirectory=terminal-l1-l2/query
ExecStartPre=/usr/bin/mountpoint -q /srv/terminal-data
ExecStartPre=+/opt/terminal-l1-l2/ops/scripts/check-service-env.sh /etc/terminal-l1-l2/query/service.env query
ExecStartPre=/usr/bin/test -r /srv/terminal-data/query-catalogs/archive-sources.json
ExecStartPre=/usr/bin/test -r /srv/terminal-data/query-catalogs/databento/CURRENT.json
ExecStartPre=/usr/bin/test -r /srv/terminal-data/query-catalogs/binance/CURRENT.json
ExecStart=/opt/terminal-l1-l2/converter-env/.venv/bin/python /opt/terminal-l1-l2/current/apps/runtime/conversion/archive_http.py --bucket chartprime-historical-data --curated-prefix curated --sources-file /srv/terminal-data/query-catalogs/archive-sources.json --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/srv/terminal-data/curated
ReadOnlyPaths=/srv/terminal-data/query-catalogs
ReadWritePaths=/srv/terminal-data/query-cache
MemoryHigh=3G
MemoryMax=6G
TasksMax=128
Nice=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-archive-query

[Install]
WantedBy=multi-user.target
