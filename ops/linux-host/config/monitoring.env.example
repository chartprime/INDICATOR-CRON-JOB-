# /etc/terminal-l1-l2/monitoring.env -- root-owned, chmod 0644, no secrets.
#
# Free-space floors in GiB (positive integer, no leading zero, 1..1048576).
# Below a floor, or if a value is invalid, check-disk-space.sh exits non-zero
# and OnFailure -> terminal-alert@. Real numbers: W6.05 / W6.06 / W6.16.
TT_DISK_MIN_FREE_DATA_GIB=100
TT_DISK_MIN_FREE_ROOT_GIB=10

# This file deliberately contains no alert command or credentials. The optional
# root-only alert-email.env file owns those settings.
