# /etc/terminal-l1-l2/alert-email.env -- root:root 0600.
# Read only by terminal-alert@.service. Never merge these settings into the
# non-secret monitoring.env file. Recipient can be changed at any time.
TT_ALERT_COMMAND=/opt/terminal-l1-l2/ops/scripts/send-alert-email.py
TT_SMTP_HOST=
TT_SMTP_PORT=587
TT_SMTP_TLS=starttls
TT_SMTP_USERNAME=
TT_SMTP_PASSWORD=
TT_ALERT_FROM=
TT_ALERT_TO=
