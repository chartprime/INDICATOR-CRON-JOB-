# Template for /etc/terminal-l1-l2/convert/service.env
# Real file: root-owned, chmod 0600, outside the checkout. Loaded by systemd
# EnvironmentFile= before the ttconvert user is entered. Placeholders only.
# Variable names come from the repository root .env.example.
#
# Historical-provider credentials. Never printed or logged by the tools; only
# non-secret entitlement fields are surfaced.
databento_key=
tardis_key=

# Completed archive jobs use this optional remote name.
TT_DATABENTO_REMOTE=

# Required scoped S3 identity for terminal-backfill@. The Python publisher
# requires REGION, ACCESS_KEY_ID and SECRET_ACCESS_KEY. TYPE and PROVIDER keep
# the same protected environment usable by rclone-based archive tools.
# Grant raw/* read-only and curated/* scoped read/write only. Never grant raw
# write or delete permissions to this identity.
RCLONE_CONFIG_TTCONVERT_TYPE=s3
RCLONE_CONFIG_TTCONVERT_PROVIDER=AWS
RCLONE_CONFIG_TTCONVERT_REGION=eu-central-1
RCLONE_CONFIG_TTCONVERT_ACCESS_KEY_ID=
RCLONE_CONFIG_TTCONVERT_SECRET_ACCESS_KEY=
