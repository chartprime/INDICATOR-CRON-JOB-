    { "id": "replay-7d-progressive", "runner": "http", "manifest": "benchmarks/live-storage/deep-binance-replay-7d.json", "telemetry": "required", "states": ["cold", "warm"], "repetitions": 5, "completion": "progressive", "metrics": [{ "name": "first-page-p95-ms", "path": "byRoutePage.replay-page.0.latencyMs.p95", "operator": "max", "threshold": 3000 }, { "name": "page-p95-ms", "path": "summary.latencyMs.p95", "operator": "max", "threshold": 5000 }] },

