# Operator settings (owner only; developers never need these).
# Copy the sections you use into the same repository-root .env. Terminal C and D
# never load these keys; only the operator commands that need them do.
# Host services do not read this file: they use /etc/terminal-l1-l2 (templates
# in ops/linux-host/config/). Never commit, log or pass a value on a command line.

# Provider keys for local raw backfill (backfill:databento:live, backfill:tardis:live).
databento_key=
tardis_key=
# TT_DATABENTO_REMOTE=

# ttconvert: conversion S3 identity (raw read, curated read/write).
RCLONE_CONFIG_TTCONVERT_TYPE=s3
RCLONE_CONFIG_TTCONVERT_PROVIDER=AWS
RCLONE_CONFIG_TTCONVERT_REGION=eu-central-1
RCLONE_CONFIG_TTCONVERT_ACCESS_KEY_ID=
RCLONE_CONFIG_TTCONVERT_SECRET_ACCESS_KEY=

# Binance qualification runs: disposable identities, never production curated.
TT_A6_RAW_S3_REGION=eu-central-1
TT_A6_RAW_S3_ACCESS_KEY_ID=
TT_A6_RAW_S3_SECRET_ACCESS_KEY=
TT_A6_QUALIFICATION_S3_REGION=eu-central-1
TT_A6_QUALIFICATION_S3_ACCESS_KEY_ID=
TT_A6_QUALIFICATION_S3_SECRET_ACCESS_KEY=

# Historical Mode straight from S3 on a laptop (docs/operations/08-operator-tooling.md).
# Read-only curated identity, and the secret the gateway presents to the query service.
TT_QUERY_S3_REGION=eu-central-1
TT_QUERY_S3_ACCESS_KEY_ID=
TT_QUERY_S3_SECRET_ACCESS_KEY=
TT_QUERY_SERVICE_SECRET=

# Running the archive gateway locally: bearers as clientId:secret pairs, comma-separated.
TT_ARCHIVE_SERVICE_URL=http://127.0.0.1:8002/query
TT_ARCHIVE_CLIENT_TOKENS=
TT_LIVE_STORAGE_INTERNAL_URL=http://127.0.0.1:8003
TT_LIVE_STORAGE_SERVICE_SECRET=
