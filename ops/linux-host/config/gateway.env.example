# Template for /etc/terminal-l1-l2/gateway/service.env
# Real file: root-owned, chmod 0600, outside the checkout. Loaded by systemd
# EnvironmentFile= before the ttgateway user is entered. Placeholders only.
#
# Where the gateway forwards queries. Must be an unauthenticated loopback /query
# URL; archive-route refuses to construct on anything else, which leaves the
# gateway listening and reporting its reason rather than proxying off-host.
TT_ARCHIVE_SERVICE_URL=http://127.0.0.1:8002/query
# Optional: enable only after the reviewed historical L2 reader is running.
# TT_L2_ARCHIVE_SERVICE_URL=http://127.0.0.1:8004/query
#
# Bind address for the Node process. The unit defaults to 127.0.0.1. A host
# exposing the gateway on the lab WireGuard interface sets this to 10.88.0.1.
# Tailscale addresses are also code-validated for a separately qualified
# topology; 0.0.0.0 and the public NIC are refused.
# TT_ARCHIVE_GATEWAY_HOST=127.0.0.1
#
# The same value as TT_QUERY_SERVICE_SECRET in
# /etc/terminal-l1-l2/query/service.env. It authenticates this gateway to the
# Python service and nothing else. It is not a user credential and must never
# reach a browser build.
TT_QUERY_SERVICE_SECRET=
#
# Browser bearer credentials, as comma-separated clientId:secret pairs. Each
# secret is at least 24 characters from the token68 alphabet. These are the only
# archive credentials a browser ever holds, and they are separate from the
# service secret above. A browser token grants the per-client concurrency and
# rate budget of that clientId, so issue one per consumer rather than sharing.
TT_ARCHIVE_CLIENT_TOKENS=
#
# Where the gateway relays /live-storage/* requests. Must be an unauthenticated
# loopback URL with no path; live-storage-relay refuses to construct on
# anything else. The same TT_ARCHIVE_CLIENT_TOKENS above authenticate this
# route too -- one bearer per developer, covering both routes.
TT_LIVE_STORAGE_INTERNAL_URL=http://127.0.0.1:8003
#
# The same value as TT_LIVE_STORAGE_SERVICE_SECRET in
# /etc/terminal-l1-l2/live-storage/service.env. Authenticates this gateway to
# the live-storage service and nothing else, separate from
# TT_QUERY_SERVICE_SECRET above.
TT_LIVE_STORAGE_SERVICE_SECRET=
