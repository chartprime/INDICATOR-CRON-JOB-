[Unit]
Description=Terminal-L1-L2 daily-notional VPIN rollup maintenance
Wants=network-online.target
After=network-online.target time-sync.target
RequiresMountsFor=/srv/terminal-data
OnFailure=terminal-alert@%n.service

[Service]
Type=oneshot
User=ttcollect
Group=ttcollect
Slice=terminal.slice
WorkingDirectory=/opt/terminal-l1-l2/current/apps/runtime
Environment=TT_DATA_ROOT=/srv/terminal-data/capture
Environment=TT_LOG_DIR=/var/log/terminal-l1-l2/maintain
LogsDirectory=terminal-l1-l2/maintain
ExecStartPre=/usr/bin/mountpoint -q /srv/terminal-data
ExecStart=/opt/terminal-l1-l2/node-v24.21.0-linux-x64/bin/node /opt/terminal-l1-l2/current/apps/runtime/scripts/maintain/maintain-daily-notional-rollup.js
TimeoutStartSec=150
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
ReadWritePaths=/srv/terminal-data/capture
MemoryMax=256M
TasksMax=32
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-daily-notional-rollup
