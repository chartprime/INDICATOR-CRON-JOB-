    { "id": "browser-load", "runner": "browser", "manifest": "benchmarks/browser/steady-tape-2000.json", "states": ["neutral"], "repetitions": 5, "metrics": [] },
    { "id": "browser-all-indicators", "runner": "external", "procedure": "Run the fixed-profile real Terminal D Chrome trace with every supported live indicator enabled; attach CPU, heap, GC, layout, paint, long-task and semantic screenshot/state evidence.", "states": ["neutral"], "repetitions": 5, "metrics": [{ "name": "tick-to-paint-p95-ms", "path": "metrics.tickToPaintP95Ms", "operator": "max", "threshold": 100 }] },
    { "id": "browser-hidden-tab", "runner": "external", "procedure": "Run the fixed-profile real Terminal D tab visible, backgrounded for ten minutes, then visible; prove bounded queues, no stale-generation application and recovery-to-paint latency.", "states": ["neutral"], "repetitions": 5, "metrics": [{ "name": "resume-to-paint-ms", "path": "metrics.resumeToPaintMs", "operator": "max", "threshold": 2000 }] },

    { "id": "ws-fanout-8", "runner": "ws", "manifest": "benchmarks/ws/fanout-8-clients-1k-trades.json", "states": ["neutral"], "repetitions": 5, "metrics": [{ "name": "healthy-client-p95-ms", "path": "latencyMs.healthy.p95", "operator": "max", "threshold": 100 }] },
    { "id": "ws-fanout-32", "runner": "ws", "manifest": "benchmarks/ws/fanout-32-clients-500-trades.json", "states": ["neutral"], "repetitions": 5, "metrics": [{ "name": "healthy-client-p95-ms", "path": "latencyMs.healthy.p95", "operator": "max", "threshold": 100 }] },
    { "id": "ws-slow-client-eviction", "runner": "ws", "manifest": "benchmarks/ws/slow-client-eviction.json", "states": ["neutral"], "repetitions": 5, "metrics": [] },
