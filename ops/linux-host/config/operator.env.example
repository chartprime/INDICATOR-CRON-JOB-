# Operator worksheet only: not consumed automatically by runtime or scripts.
# Keep populated copy outside the checkout. No private keys/passwords here.
TT_HOST_ADDRESS=
TT_HOST_SSH_PORT=22
TT_HOST_USERNAME=ttadmin
TT_HOST_SSH_KEY_PATH=
TT_HOST_SSH_HOSTKEY_SHA256=
TT_HOST_PROVIDER=HOSTKEY
TT_HOST_REGION=Poland
TT_SERVER_CONFIG_DIRECTORY=/etc/terminal-l1-l2
# Implemented on the Poland host; not a portable default for other hosts:
TT_SERVER_CAPTURE_DIRECTORY=/srv/terminal-data/capture
TT_NODE_EXECUTABLE=/opt/terminal-l1-l2/node-v24.21.0-linux-x64/bin/node
TT_ARCHIVE_PROVIDER=
TT_ARCHIVE_BUCKET=
TT_ARCHIVE_REGION=
# Actual service environment files will be root-owned outside the checkout.
# Application variable names come from ../../.env.example (developer) and
# ../../.env.operator.example (operator); never give operator values to viewers.
