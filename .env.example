# Developer settings. Copy to .env (git-ignored) and fill in only what you have.
# With nothing set, the terminal runs live on Binance. Check with: npm run doctor
# How to get access: docs/operations/00-developer-onboarding.md
# Never commit or share a filled-in value.

# Host data: Historical Mode and indicator warm-up (needs your WireGuard tunnel).
# Uncomment all four and put your bearer in both bearer lines.
# TT_ARCHIVE_PROXY_URL=http://10.88.0.1:8001
# VITE_ARCHIVE_CLIENT_TOKEN=<your-bearer>
# TT_LIVE_STORAGE_SERVICE_URL=http://10.88.0.1:8001/live-storage
# TT_LIVE_STORAGE_CLIENT_TOKEN=<your-bearer>

# dxFeed live: ES, NQ, AAPL, TSLA, NVDA (needs Tailscale access to the token broker).
TT_DXFEED_TOKEN_BROKER_URL=

# Node 24.21.0 folder, only if your shell runs another Node and nvm, fnm or volta do not have it.
# TT_NODE_BIN=

# Heatmap: keep history for every Binance pair, eleven hours deep.
L2_HEATMAP_TRACK_ALL=1
L2_HEATMAP_DEEP_S=39600
# Heatmap coarse tier, for the 4h and daily charts: five-minute columns on rows
# forty times as tall, rebuilt from the host book recording and kept in the
# store. Off unless set. A week is 604800; a daily chart wants a month or more.
# The first cold start replays that many days of book per tracked pair, in
# 2 h chunks, a few minutes per day each, one pair after another.
# L2_HEATMAP_COARSE_S=604800
