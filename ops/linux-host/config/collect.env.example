# Template for /etc/terminal-l1-l2/collect/service.env
# Real file: root-owned, chmod 0600, outside the checkout. Loaded by systemd
# EnvironmentFile= before the ttcollect user is entered; the service account
# never reads it directly. Placeholders only here. Variable names come from
# the repository root .env.example.
#
# COMPLIANCE: the dxFeed token broker URL is not itself a secret, but a live
# dxFeed/CME session is monitored and dev-use only. Leave this blank on a host
# that must not open a dxFeed connection. Only the dxFeed unit needs it; the
# Binance collector reads no secret and this file may be empty for it.
TT_DXFEED_TOKEN_BROKER_URL=

# TT_DATA_ROOT / TT_LOG_DIR are set directly on the collector units
# (Environment=), not here -- they are fixed deployment paths, not secrets.
# See ../docs/data-layout.md. A future retention / max-DB-size override for
# this host would go here.
