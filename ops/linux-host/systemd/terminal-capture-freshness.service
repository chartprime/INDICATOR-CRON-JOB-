[Unit]
Description=Terminal-L1-L2 capture freshness check
OnFailure=terminal-alert@%n.service

[Service]
Type=oneshot
User=ttquery
Group=ttquery
EnvironmentFile=-/etc/terminal-l1-l2/monitoring.env
ExecStart=/opt/terminal-l1-l2/ops/scripts/check-capture-freshness.sh
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
MemoryMax=64M
TasksMax=16
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-capture-freshness
