{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminal-l1-l2/contracts/dxfeed-canonical-event/v1",
  "title": "dxFeed Canonical Event v1",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/degradedEnvelope" }
  ],
  "$defs": {
    "assetClass": { "enum": ["FUTURE", "EQUITY"] },
    "eventType": { "enum": ["QUOTE", "TRADE", "ORDER", "TIMEANDSALE"] },
    "recoveryState": { "enum": ["READY", "RECOVERING", "UNAVAILABLE"] },
    "nonBlankString": { "type": "string", "pattern": "\\S" },
    "venue": {
      "oneOf": [
        { "$ref": "#/$defs/nonBlankString" },
        { "type": "null" }
      ]
    },
    "envelope": {
      "type": "object",
      "required": [
        "provider", "venue", "assetClass", "providerSymbol", "eventType",
        "eventTime", "receivedAt", "timingClass", "stale", "recoveryState", "payload"
      ],
      "properties": {
        "provider": { "const": "DXFEED" },
        "venue": { "$ref": "#/$defs/venue" },
        "assetClass": { "$ref": "#/$defs/assetClass" },
        "providerSymbol": { "$ref": "#/$defs/nonBlankString" },
        "eventType": { "$ref": "#/$defs/eventType" },
        "eventTime": { "type": "string", "format": "date-time" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "timingClass": { "const": "REALTIME" },
        "stale": { "type": "boolean" },
        "recoveryState": { "$ref": "#/$defs/recoveryState" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/quotePayload" },
            { "$ref": "#/$defs/tradePayload" },
            { "$ref": "#/$defs/orderPayload" },
            { "$ref": "#/$defs/timeAndSalePayload" }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "recoveryState": { "enum": ["RECOVERING", "UNAVAILABLE"] } },
            "required": ["recoveryState"]
          },
          "then": { "properties": { "stale": { "const": true } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "QUOTE" } }, "required": ["eventType"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/quotePayload" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "TRADE" } }, "required": ["eventType"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/tradePayload" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "ORDER" } }, "required": ["eventType"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/orderPayload" } } }
        },
        {
          "if": { "properties": { "eventType": { "const": "TIMEANDSALE" } }, "required": ["eventType"] },
          "then": { "properties": { "payload": { "$ref": "#/$defs/timeAndSalePayload" } } }
        }
      ]
    },
    "quotePayload": {
      "type": "object",
      "required": ["bidPrice", "bidSize", "bidTime", "bidExchangeCode", "askPrice", "askSize", "askTime", "askExchangeCode"],
      "properties": {
        "bidPrice": { "type": "number", "exclusiveMinimum": 0 },
        "bidSize": { "type": "number", "minimum": 0 },
        "bidTime": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
        "bidExchangeCode": { "$ref": "#/$defs/nonBlankString" },
        "askPrice": { "type": "number", "exclusiveMinimum": 0 },
        "askSize": { "type": "number", "minimum": 0 },
        "askTime": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
        "askExchangeCode": { "$ref": "#/$defs/nonBlankString" }
      },
      "additionalProperties": false
    },
    "tradePayload": {
      "type": "object",
      "required": ["price", "size", "time", "exchangeCode", "change", "dayVolume", "dayTurnover", "tickDirection", "extendedTradingHours"],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "time": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
        "exchangeCode": { "$ref": "#/$defs/nonBlankString" },
        "change": { "type": "number" },
        "dayVolume": { "type": "number", "minimum": 0 },
        "dayTurnover": { "type": "number", "minimum": 0 },
        "tickDirection": { "$ref": "#/$defs/nonBlankString" },
        "extendedTradingHours": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "orderPayload": {
      "type": "object",
      "required": ["time", "action", "price", "size", "side", "scope", "source", "index", "orderId"],
      "properties": {
        "index": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "time": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
        "action": { "$ref": "#/$defs/nonBlankString" },
        "orderId": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "size": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "side": { "$ref": "#/$defs/nonBlankString" },
        "scope": { "$ref": "#/$defs/nonBlankString" },
        "source": { "$ref": "#/$defs/nonBlankString" },
        "marketMaker": { "$ref": "#/$defs/nonBlankString" }
      },
      "additionalProperties": false
    },
    "timeAndSalePayload": {
      "type": "object",
      "required": [
        "price", "size", "time", "timeNanoPart", "sequence", "exchangeCode",
        "extendedTradingHours", "aggressorSide", "spreadLeg", "validTick",
        "type", "index", "tradeId"
      ],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "time": { "type": "integer", "minimum": 1, "maximum": 8640000000000000 },
        "timeNanoPart": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "exchangeCode": { "$ref": "#/$defs/nonBlankString" },
        "extendedTradingHours": { "type": "boolean" },
        "aggressorSide": { "enum": ["BUY", "SELL", "UNDEFINED"] },
        "spreadLeg": { "type": "boolean" },
        "validTick": { "type": "boolean" },
        "type": { "enum": ["NEW", "CORRECTION", "CANCEL"] },
        "index": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        },
        "tradeId": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "degradedEnvelope": {
      "type": "object",
      "required": [
        "provider", "venue", "assetClass", "providerSymbol", "eventType",
        "receivedAt", "timingClass", "stale", "recoveryState", "state", "reason", "missingFields"
      ],
      "properties": {
        "provider": { "const": "DXFEED" },
        "venue": { "$ref": "#/$defs/venue" },
        "assetClass": { "$ref": "#/$defs/assetClass" },
        "providerSymbol": { "$ref": "#/$defs/nonBlankString" },
        "eventType": { "$ref": "#/$defs/eventType" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "timingClass": { "const": "REALTIME" },
        "stale": { "type": "boolean" },
        "recoveryState": { "$ref": "#/$defs/recoveryState" },
        "state": { "const": "UNAVAILABLE" },
        "reason": {
          "enum": [
            "MALFORMED_RAW_MESSAGE",
            "STREAM_SYMBOL_MISMATCH",
            "PROVIDER_EVENT_TYPE_MISMATCH",
            "MISSING_OR_INVALID_REQUIRED_FIELD"
          ]
        },
        "missingFields": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "recoveryState": { "enum": ["RECOVERING", "UNAVAILABLE"] } },
            "required": ["recoveryState"]
          },
          "then": { "properties": { "stale": { "const": true } } }
        },
        {
          "if": {
            "properties": { "reason": { "const": "MISSING_OR_INVALID_REQUIRED_FIELD" } },
            "required": ["reason"]
          },
          "then": { "properties": { "missingFields": { "minItems": 1 } } },
          "else": { "properties": { "missingFields": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
