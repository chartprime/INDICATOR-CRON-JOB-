root = true

# Line endings are left to git's core.autocrlf normalization (no .gitattributes
# in this repo), so end_of_line is intentionally not pinned here.
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
