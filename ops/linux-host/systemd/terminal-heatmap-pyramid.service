# Heatmap pyramid (P4c.3). Replays the capture into 10 s / 30 s / 1 m / 5 m
# heatmap columns, 7 days per pair, under /srv/terminal-data/heatmap.
# Reads the capture only; live-storage serves the stores it writes.
[Unit]
Description=Terminal-L1-L2 heatmap pyramid builder
After=time-sync.target terminal-collector.service
RequiresMountsFor=/srv/terminal-data
StartLimitIntervalSec=3600
StartLimitBurst=5
OnFailure=terminal-alert@%n.service

[Service]
Type=simple
User=ttcollect
Group=ttcollect
Slice=terminal.slice
WorkingDirectory=/opt/terminal-l1-l2/current/apps/runtime
Environment=NODE_ENV=production
Environment=TT_DATA_ROOT=/srv/terminal-data/capture
Environment=TT_LOG_DIR=/var/log/terminal-l1-l2/heatmap-pyramid
Environment=TT_HEATMAP_DIR=/srv/terminal-data/heatmap
Environment=TT_PYRAMID_BINANCE_DB_PATH=/srv/terminal-data/capture/live/market-data.sqlite
Environment=TT_PYRAMID_DXFEED_DB_PATH=/srv/terminal-data/capture/live/dxfeed-market-data.sqlite
LogsDirectory=terminal-l1-l2/heatmap-pyramid
ExecStartPre=/usr/bin/mountpoint -q /srv/terminal-data
ExecStartPre=/usr/bin/test -d /srv/terminal-data/heatmap
ExecStartPre=/usr/bin/test -r /srv/terminal-data/capture/live/market-data.sqlite
ExecStart=/opt/terminal-l1-l2/node-v24.21.0-linux-x64/bin/node /opt/terminal-l1-l2/current/apps/runtime/scripts/serve/run-heatmap-pyramid.js
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=60
TimeoutStopSec=180
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadOnlyPaths=/srv/terminal-data/capture
ReadWritePaths=/srv/terminal-data/heatmap
CPUQuota=150%
MemoryHigh=2G
MemoryMax=3G
TasksMax=64
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
SyslogIdentifier=terminal-heatmap-pyramid

[Install]
WantedBy=multi-user.target
